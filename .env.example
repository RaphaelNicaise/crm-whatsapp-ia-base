# Configuración de tu CRM con IA y WhatsApp.
# Las claves sensibles también se pueden configurar desde el panel web (Ajustes -> Conexiones).
PUERTO=8000

# Base de datos PostgreSQL (Recomendado para producción / Docker / Portainer):
# Puedes usar un contenedor Postgres local o un servicio en la nube (Supabase, Neon, etc.).
# Si se deja vacío, el CRM usa el Postgres embebido local (carpeta datos/).
DATABASE_URL=postgresql://crm:crm_password@postgres:5432/crm_db
# SUPABASE_DB_URL=

# Dominio y URL pública (Modo Servidor / Docker):
# CRM_DOMINIO=crm.tunegocio.com
# CRM_URL_PUBLICA=https://crm.tunegocio.com

# Opcional: ngrok para desarrollo local o pruebas
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=
